using System;
using System.Collections.Generic;
using System.Configuration;
using System.Data;
using System.Data.SqlClient;
using System.Linq;
using System.Web;
using System.Web.UI;
using System.Web.UI.WebControls;

namespace Job_Portal
{
    public partial class my_applications : System.Web.UI.Page
    {
        String s = ConfigurationManager.ConnectionStrings["JobPortalConnection"].ConnectionString;
        SqlConnection con;
        SqlCommand cmd;
        SqlDataAdapter da;
        DataTable dt;

        void getcon()
        {
            con = new SqlConnection(s);
            con.Open();
        }

        protected void Page_Load(object sender, EventArgs e)
        {
            if (!IsPostBack)
            {
                if (Session["UserID"] == null || Session["Role"].ToString() != "JobSeeker")
                {
                    Response.Redirect("login.aspx");
                }
                else
                {
                    LoadApplications();
                }
            }
        }

        private void LoadApplications()
        {
            int userId = Convert.ToInt32(Session["UserID"]);
            
            getcon();
            string query = "SELECT ja.ApplicationID, j.JobTitle, j.Location, j.Salary, j.Category, ja.ApplicationDate, ja.Status FROM JobApplications ja INNER JOIN Jobs j ON ja.JobID = j.JobID WHERE ja.JobSeekerID = '" + userId + "' ORDER BY ja.ApplicationDate DESC";
            
            cmd = new SqlCommand(query, con);
            da = new SqlDataAdapter(cmd);
            dt = new DataTable();
            da.Fill(dt);
            
            con.Close();
        }
    }
}