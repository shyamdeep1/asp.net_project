using System;
using System.Data;
using System.Data.SqlClient;
using System.Configuration;
using System.Web.UI.WebControls;

namespace Job_Portal
{
    public partial class job_details : System.Web.UI.Page
    {
        String s = ConfigurationManager.ConnectionStrings["JobPortalConnection"].ConnectionString;
        SqlConnection con;
        SqlCommand cmd;
        string resumeFileName;
        

        void getcon()
        {
            con = new SqlConnection(s);
            con.Open();
        }

        protected void Page_Load(object sender, EventArgs e)
        {
            if (!IsPostBack)
            {
                if (Request.QueryString["JobID"] != null)
                {
                    LoadJobDetails(Request.QueryString["JobID"]);
                    CheckUserLogin();
                }
                else
                {
                    Response.Redirect("job_listings.aspx");
                }
            }
        }

        private void CheckUserLogin()
        {
            if (Session["UserID"] == null)
            {
                pnlApplicationForm.Visible = false;
                pnlLoginRequired.Visible = true;
                btnApplyNow.Visible = false;
                btnSaveJob.Visible = false;
            }
            else
            {
                pnlApplicationForm.Visible = true;
                pnlLoginRequired.Visible = false;
                
                if (Session["UserID"] != null)
                {
                    txtFullName.Text = Session["FullName"].ToString();
                    LoadUserDetails();
                }
            }
        }

        private void LoadUserDetails()
        {
            int userId = Convert.ToInt32(Session["UserID"]);
            getcon();
            cmd = new SqlCommand("SELECT Email FROM Users WHERE UserID = '" + userId + "'", con);
            SqlDataReader reader = cmd.ExecuteReader();
            
            if (reader.Read())
            {
                txtEmail.Text = reader["Email"].ToString();
            }
            reader.Close();
            con.Close();
        }

        private void LoadJobDetails(string jobId)
        {
            getcon();
            cmd = new SqlCommand("SELECT j.*, r.CompanyName FROM Jobs j INNER JOIN Recruiters r ON j.RecruiterID = r.RecruiterID WHERE j.JobID = '" + jobId + "'", con);
            
            SqlDataReader dr = cmd.ExecuteReader();
            if (dr.Read())
            {
                lblJobTitle.Text = dr["JobTitle"].ToString();
                lblCompanyName.Text = dr["CompanyName"].ToString();
                lblLocation.Text = dr["Location"].ToString();
                lblJobType.Text = dr["JobType"].ToString();
                lblJobDescription.Text = dr["JobDescription"].ToString();
                lblResponsibilities.Text = dr["JobDescription"].ToString();
                lblEducationExperience.Text = dr["ExperienceRequired"].ToString();
                lblSkillsRequired.Text = dr["SkillsRequired"].ToString();
                lblPublishDate.Text = Convert.ToDateTime(dr["PostedDate"]).ToString("MMM dd, yyyy");
                lblEmploymentStatus.Text = dr["JobType"].ToString();
                lblExperience.Text = dr["ExperienceRequired"].ToString();
                lblJobLocation.Text = dr["Location"].ToString();
                lblSalary.Text = dr["Salary"].ToString();
                
                if (dr["Deadline"] != DBNull.Value)
                {
                    lblDeadline.Text = Convert.ToDateTime(dr["Deadline"]).ToString("MMM dd, yyyy");
                }

                if (dr["Company_Logo"] != DBNull.Value && !string.IsNullOrEmpty(dr["Company_Logo"].ToString()))
                {
                    imgCompanyLogo.ImageUrl = dr["Company_Logo"].ToString();
                }
                else
                {
                    imgCompanyLogo.ImageUrl = "~/images/job_logo_1.jpg";
                }
            }
            dr.Close();
            con.Close();
        }

        protected void btnApplyNow_Click(object sender, EventArgs e)
        {
            System.Web.UI.ScriptManager.RegisterStartupScript(this, this.GetType(), "scroll", "document.getElementById('pnlApplicationForm').scrollIntoView();", true);
        }

        protected void btnSaveJob_Click(object sender, EventArgs e)
        {
            if (Session["UserID"] == null)
            {
                Response.Redirect("login.aspx");
                return;
            }

            int userId = Convert.ToInt32(Session["UserID"]);
            int jobId = Convert.ToInt32(Request.QueryString["JobID"]);

            getcon();
            cmd = new SqlCommand("SELECT COUNT(*) FROM SavedJobs WHERE JobSeekerID = '" + userId + "' AND JobID = '" + jobId + "'", con);
            int exists = (int)cmd.ExecuteScalar();

            if (exists == 0)
            {
                cmd = new SqlCommand("INSERT INTO SavedJobs (JobSeekerID, JobID, SavedDate) VALUES ('" + userId + "', '" + jobId + "', '" + DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") + "')", con);
                cmd.ExecuteNonQuery();
                lblMessage.Text = "Job saved successfully!";
                lblMessage.CssClass = "text-success mb-3 d-block";
            }
            else
            {
                lblMessage.Text = "Job already saved!";
                lblMessage.CssClass = "text-warning mb-3 d-block";
            }
            con.Close();
        }

        protected void btnSubmitApplication_Click(object sender, EventArgs e)
        {
            if (Session["UserID"] == null)
            {
                Response.Redirect("login.aspx");
                return;
            }

            int userId = Convert.ToInt32(Session["UserID"]);
            int jobId = Convert.ToInt32(Request.QueryString["JobID"]);

            getcon();
            cmd = new SqlCommand("SELECT COUNT(*) FROM JobApplications WHERE JobSeekerID = '" + userId + "' AND JobID = '" + jobId + "'", con);
            int alreadyApplied = (int)cmd.ExecuteScalar();
            con.Close();

            if (alreadyApplied > 0)
            {
                lblMessage.Text = "You have already applied for this job!";
                lblMessage.CssClass = "text-warning mb-3 d-block";
                return;
            }

            if (fuResume.HasFile)
            {
                resumeFileName = "~/Resumes/" + userId + "_" + DateTime.Now.Ticks + "_" + fuResume.FileName;
                fuResume.SaveAs(Server.MapPath(resumeFileName));
            }

            getcon();
            string query = "INSERT INTO JobApplications (JobID, JobSeekerID, FullName, Email, Phone, Resume, Experience, CoverLetter, CurrentSalary, ExpectedSalary, ApplicationDate, Status) VALUES ('" + jobId + "', '" + userId + "', '" + txtFullName.Text.Trim() + "', '" + txtEmail.Text.Trim() + "', '" + txtPhone.Text.Trim() + "', '" + resumeFileName + "', '" + ddlExperience.SelectedValue + "', '" + txtCoverLetter.Text.Trim() + "', '" + txtCurrentSalary.Text.Trim() + "', '" + txtExpectedSalary.Text.Trim() + "', '" + DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") + "', 'Pending')";
            
            cmd = new SqlCommand(query, con);
            cmd.ExecuteNonQuery();
            con.Close();

            lblMessage.Text = "Application submitted successfully!";
            lblMessage.CssClass = "text-success mb-3 d-block";
            ClearForm();
        }

        private void ClearForm()
        {
            txtPhone.Text = "";
            ddlExperience.SelectedIndex = 0;
            txtCoverLetter.Text = "";
            txtCurrentSalary.Text = "";
            txtExpectedSalary.Text = "";
        }
    }
}