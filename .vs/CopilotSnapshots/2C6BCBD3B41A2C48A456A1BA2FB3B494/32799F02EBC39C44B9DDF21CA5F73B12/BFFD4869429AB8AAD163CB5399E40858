        protected void Page_Load(object sender, EventArgs e)
        {
            if (!IsPostBack)
            {
                if (Session["UserID"] == null || Session["Role"].ToString() != "JobSeeker")
                {
                    Response.Redirect("login.aspx");
                }
                else
                {
                    LoadProfileData();
                }
            }
        }

