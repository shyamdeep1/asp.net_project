using System;
using System.Collections.Generic;
using System.Configuration;
using System.Data;
using System.Data.SqlClient;
using System.Linq;
using System.Web;
using System.Web.UI;
using System.Web.UI.WebControls;

namespace Job_Portal
{
    public partial class job_listings : System.Web.UI.Page
    {
        String s = ConfigurationManager.ConnectionStrings["JobPortalConnection"].ConnectionString;
        SqlConnection con;
        SqlCommand cmd;
        SqlDataAdapter da;
        DataTable dt;

        void getcon()
        {
            con = new SqlConnection(s);
            con.Open();
        }

        protected void Page_Load(object sender, EventArgs e)
        {
            if (!IsPostBack)
            {
                LoadJobListings();
            }
        }

        private void LoadJobListings()
        {
            try
            {
                getcon();
                string query = "SELECT JobID, Location, Salary, SkillsRequired, ExperienceRequired, JobType, Category, Deadline, Status, Company_Logo FROM Jobs ORDER BY JobID DESC";
                
                cmd = new SqlCommand(query, con);
                da = new SqlDataAdapter(cmd);
                dt = new DataTable();
                da.Fill(dt);
                
                // Bind to repeater or gridview control
                // Example: rptJobListings.DataSource = dt;
                // rptJobListings.DataBind();
                
                con.Close();
            }
            catch (Exception ex)
            {
                // Handle error
                if (con != null && con.State == ConnectionState.Open)
                    con.Close();
            }
        }
    }
}